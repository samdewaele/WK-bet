generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String?                  @unique
  emailVerified           DateTime?
  image                   String?
  role                    String                   @default("user")
  accounts                Account[]
  sessions                Session[]
  predictions             Prediction[]
  koPredictions           KOPrediction[]
  memberships             RoomMember[]
  groupPredictions        GroupStandingPrediction[]
  sideBetEntries          SideBetEntry[]
  proposedSideBets        SideBet[]                @relation("SideBetProposer")
  p2pBetsProposed         P2PSideBet[]             @relation("P2PProposer")
  p2pBetsAccepted         P2PSideBet[]             @relation("P2PAcceptor")
  createdRooms            Room[]                   @relation("RoomCreator")
  createdAt               DateTime                 @default(now())
}

model Room {
  id               String                   @id @default(cuid())
  name             String
  description      String?
  image            String?                  // base64 data URL (small avatar)
  inviteCode       String                   @unique @default(cuid())
  creatorId        String?
  entryFee         Float                    @default(0)
  // setup | betting | closed | group_active | ko_betting | ko_active | settling | finished
  status           String                   @default("setup")
  simulationMode   Boolean                  @default(false)
  uberBetsLocked   Boolean                  @default(false)
  members          RoomMember[]
  groupPredictions GroupStandingPrediction[]
  predictions      Prediction[]
  koPredictions    KOPrediction[]
  sideBets         SideBet[]
  p2pBets          P2PSideBet[]
  creator          User?                    @relation("RoomCreator", fields: [creatorId], references: [id])
  createdAt        DateTime                 @default(now())
}

model RoomMember {
  id              String  @id @default(cuid())
  userId          String
  roomId          String
  paid            Boolean @default(false)
  excludedFromPot Boolean @default(false)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  room            Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model Team {
  id          String  @id @default(cuid())
  fdId        Int?    @unique // football-data.org numeric team ID for reliable API matching
  name        String  @unique
  flag        String
  group       String
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Match {
  id            String         @id @default(cuid())
  fdMatchId     Int?           @unique // football-data.org numeric match ID — primary sync key
  homeTeamId    String?
  awayTeamId    String?
  homeTeam      Team?          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team?          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  round         String
  group         String?
  matchNumber   Int
  kickoff       DateTime
  homeScore     Int?
  awayScore     Int?
  // For KO matches level after full/extra time: which side won the shootout
  // ("home"/"away"), from football-data's score.winner. Authoritative for
  // bracket propagation and team-aware scoring (NULL for decisive results).
  penaltyWinner String?
  // The penalty shootout score (e.g. 3-2), shown alongside the level result.
  penaltyHome   Int?
  penaltyAway   Int?
  status        String         @default("scheduled")
  predictions   Prediction[]
  koPredictions KOPrediction[]
  simResult     SimResult?

  @@unique([matchNumber])
}

// Simulation-only overlay: stores fake results and bracket slots for test runs.
// The real Match table is never modified by simulation.
// All rows are deleted on every deploy (seed.ts) and on simulation cleanup.
model SimResult {
  id         String  @id @default(cuid())
  matchId    String  @unique
  homeScore  Int?
  awayScore  Int?
  homeTeamId String?
  awayTeamId String?
  match      Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// Knockout match predictions (one per user per match per room, or globally if roomId is null)
model Prediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  roomId        String?
  homeScore     Int
  awayScore     Int
  penaltyWinner String?
  points        Int?
  earnedAmount  Float?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, matchId, roomId])
}

// Knockout stage predictions — dedicated table (roomId always non-null for KO picks)
model KOPrediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  roomId        String
  homeScore     Int
  awayScore     Int
  penaltyWinner String?
  points        Int?
  earnedAmount  Float?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, matchId, roomId])
}

// Group stage: predict final standings (1st–4th) for each of the 12 WC groups
model GroupStandingPrediction {
  id           String   @id @default(cuid())
  userId       String
  roomId       String
  wcGroup      String   // "A" – "L"
  position1    String   // teamId
  position2    String
  position3    String
  position4    String
  earnedAmount Float?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, roomId, wcGroup])
}

// Uber Pot bets (any member can propose, admin/creator accepts)
model SideBet {
  id               String         @id @default(cuid())
  roomId           String
  proposedByUserId String?
  title            String
  description      String?
  // proposed | open | settled
  status           String         @default("proposed")
  winnerEntryId    String?
  room             Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposedBy       User?          @relation("SideBetProposer", fields: [proposedByUserId], references: [id], onDelete: SetNull)
  entries          SideBetEntry[]
  createdAt        DateTime       @default(now())
}

// A user's answer/prediction for a side bet
model SideBetEntry {
  id        String   @id @default(cuid())
  sideBetId String
  userId    String
  answer    String
  // A settled bet can have more than one winning entry (a tie); each winner
  // splits that bet's share of the Uber Pot. SideBet.winnerEntryId is kept as
  // the "primary" winner for backward compatibility, but this flag is the
  // source of truth for who gets paid.
  isWinner  Boolean  @default(false)
  sideBet   SideBet  @relation(fields: [sideBetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sideBetId, userId])
}

// Tracks which round-complete notification emails have been sent (prevents duplicates)
model Notification {
  id     String   @id @default(cuid())
  type   String   @unique // e.g. "round_complete:Group" | "round_complete:R32"
  sentAt DateTime @default(now())
}
model P2PSideBet {
  id          String   @id @default(cuid())
  roomId      String
  proposerId  String
  acceptorId  String?
  amount      Float
  description String
  // proposed | accepted | declined | settled
  status      String   @default("proposed")
  // "proposer" | "acceptor" — who won
  winner      String?
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposer    User     @relation("P2PProposer", fields: [proposerId], references: [id])
  acceptor    User?    @relation("P2PAcceptor", fields: [acceptorId], references: [id])
  createdAt   DateTime @default(now())
}
